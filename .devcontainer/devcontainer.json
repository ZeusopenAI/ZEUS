{
  "name": "ZEUS + Hermes Agent",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false
    }
  },
  "postCreateCommand": "bash .devcontainer/setup-hermes.sh",
  "postStartCommand": "bash .devcontainer/setup-hermes.sh --sync-only",
  "remoteEnv": {
    "HERMES_HOME": "/home/vscode/.hermes",
    "PATH": "/home/vscode/.hermes/venv/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.watcherExclude": {
          "**/.git/objects/**": true,
          "**/node_modules/**": true,
          "**/.hermes/**": true
        }
      }
    }
  },
  "hostRequirements": {
    "cpus": 2
  }
}
